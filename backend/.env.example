# PostgreSQL connection string.
# If using Supabase, use the session pooler host (aws-*.pooler.supabase.com:5432),
# not the direct db.*.supabase.co host — the direct host is IPv6-only.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/intern_management?schema=public"

PORT=5000
NODE_ENV=development
# Deployed frontend origin(s). Update both to the real URL when you deploy
# (e.g. https://your-app.vercel.app) — mismatches here cause CORS failures
# and broken invite/reset links. CORS_ORIGIN accepts a comma-separated list,
# e.g. "https://your-app.vercel.app,https://your-app-git-preview.vercel.app"
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# JWT. Generate a real secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="1d"

# Used once by `npm run seed` to create the first admin account.
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"

# Anthropic API key, used to expand a short admin-written description into a
# polished paragraph for generated offer letters / completion certificates.
# If left blank, document generation falls back to a generic default
# paragraph instead of failing. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=""

# Nodemailer / SMTP. If SMTP_HOST is left blank, invite and password-reset
# emails are logged to the backend console instead of being sent (useful for
# local development). For production, use a real SMTP provider, e.g.:
#   Gmail:    smtp.gmail.com, port 587, an App Password (not your login password)
#   SendGrid: smtp.sendgrid.net, port 587, user "apikey", pass = your API key
#   Mailgun:  smtp.mailgun.org, port 587, your Mailgun SMTP credentials
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Intern Management System <no-reply@example.com>"
